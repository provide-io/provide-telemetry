<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Provide.Telemetry</RootNamespace>
    <AssemblyName>Provide.Telemetry</AssemblyName>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <Authors>provide.io</Authors>
    <Description>Idiomatic C# provide.telemetry — logs, traces, metrics with OpenTelemetry OTLP.</Description>
    <PackageId>Provide.Telemetry</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/provide-io/provide-telemetry</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Provide.Telemetry.Tests" />
    <InternalsVisibleTo Include="RuntimeProbe" />
    <InternalsVisibleTo Include="ContractProbe" />
    <InternalsVisibleTo Include="EmitLog" />
  </ItemGroup>

</Project>
