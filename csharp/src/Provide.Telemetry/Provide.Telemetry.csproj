<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Provide.Telemetry</RootNamespace>
    <AssemblyName>Provide.Telemetry</AssemblyName>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <Authors>provide.io</Authors>
    <Description>Idiomatic C# provide.telemetry — logs, traces, metrics with no exporter dependency.</Description>
    <PackageId>Provide.Telemetry</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/provide-io/provide-telemetry</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    No PackageReference by design. The core package is BCL-only so an
    application that wants provide.telemetry without an OpenTelemetry (or
    Microsoft.Extensions.DependencyInjection) dependency can install it alone;
    delivery arrives through ITelemetryBackend from Provide.Telemetry.OpenTelemetry.
    PackageBoundaryTests enforces this against the built assembly.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Provide.Telemetry.OpenTelemetry" />
    <InternalsVisibleTo Include="Provide.Telemetry.Tests" />
    <InternalsVisibleTo Include="Provide.Telemetry.OpenTelemetry.Tests" />
    <InternalsVisibleTo Include="RuntimeProbe" />
    <InternalsVisibleTo Include="ContractProbe" />
    <InternalsVisibleTo Include="EmitLog" />
  </ItemGroup>

</Project>
